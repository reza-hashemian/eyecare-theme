#!/usr/bin/env bash
# eyecare-theme launcher (Linux / macOS)
set -euo pipefail
DIR="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
PY="$(command -v python3 || command -v python || true)"
if [ -z "$PY" ]; then echo "error: python3 not found in PATH" >&2; exit 1; fi
exec "$PY" "$DIR/lib/cli.py" "$@"
